{
  "manifest_version": 3,
  "name": "chromand palette",
  "version": "0.67",
  "permissions": ["tabs", "history", "favicon", "bookmarks", "storage"],
  "options_page": "settings.html",
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["content.css"]
    }
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "toggle the palette duh"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*", "fonts/*", "content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
